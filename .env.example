# Truth Bets — environment variables.
# Copy to .env locally (or frontend-truthbets/.env) — never commit real values.

# Frontend (Vite):
VITE_GENLAYER_RPC_URL=https://studio.genlayer.com/api
VITE_GENLAYER_NETWORK=studionet
VITE_CONTRACT_ADDRESS=0x722548962474547EB9B4Da58be0DD919628faA82

# Deployer account (genlayer CLI) — only needed for redeploying the contract.
# Generate locally with: genlayer account create
DEPLOYER_ADDRESS=
DEPLOYER_KEYSTORE_PASSWORD=
DEPLOYER_PRIVATE_KEY=